# Copy to /var/www/lwe-portal/.env on the server and fill in. Never commit or share this file.
APP_NAME="LWE Learning Portal"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://portal.learningwithearning.org
APP_TIMEZONE=UTC

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lwe_portal
DB_USERNAME=lwe_portal
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SCHEME=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Learning with Earning"

ANTHROPIC_API_KEY=

WAFLOW_ENABLED=false
WAFLOW_BASE_URL=https://hub.learningwithearning.org
WAFLOW_API_TOKEN=
WAFLOW_SEND_PATH=/api/messages/send
WAFLOW_AUTH=bearer
WAFLOW_PHONE_FIELD=phone
WAFLOW_MESSAGE_FIELD=message
WAFLOW_PHONE_FORMAT=92
WAFLOW_EXTRA=
