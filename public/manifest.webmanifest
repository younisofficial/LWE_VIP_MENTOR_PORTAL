{
  "name": "LWE Learning Portal",
  "short_name": "LWE Portal",
  "description": "Learning with Earning — classes, tasks, quizzes, attendance and your Skill Passport.",
  "start_url": "/dashboard?source=app",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0B2447",
  "theme_color": "#0B2447",
  "lang": "en",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Today", "url": "/today", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Live classes", "url": "/classes", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Mark attendance", "url": "/attendance", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
